rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeMember() { return signedIn() && (!exists(/databases/$(database)/documents/memberControls/$(request.auth.uid)) || get(/databases/$(database)/documents/memberControls/$(request.auth.uid)).data.active != false); }
    function isAdmin() { return activeMember() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'; }
    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && get(/databases/$(database)/documents/chats/$(chatId)).data.members.hasAny([request.auth.uid]);
    }
    function isGroupMember(groupId) {
      return activeMember()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if activeMember() && request.auth.uid == userId;
      allow create: if activeMember() && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if activeMember() && request.auth.uid == userId
        && resource.data.uid == userId && request.resource.data.uid == userId;
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, update, delete: if activeMember() && request.auth.uid == userId;
        allow create: if activeMember()
          && request.resource.data.fromUid == request.auth.uid
          && (
            (request.resource.data.type == 'follow'
              && exists(/databases/$(database)/documents/follows/$(request.auth.uid)/following/$(userId)))
            ||
            (request.resource.data.type == 'message'
              && request.resource.data.toUid == userId
              && request.resource.data.chatId is string
              && isChatMember(request.resource.data.chatId)
              && userId != request.auth.uid)
            ||
            (isAdmin()
              && request.resource.data.type in ['admin_message','creator_reward']
              && request.resource.data.toUid == userId
              && request.resource.data.title is string
              && request.resource.data.title.size() > 0
              && request.resource.data.title.size() <= 90
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 500
              && userId != request.auth.uid)
            ||
            (request.resource.data.type in ['like','comment']
              && request.resource.data.postId is string
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid == userId
              && userId != request.auth.uid)
          );
      }
    }

    match /publicProfiles/{userId} {
      allow read: if activeMember();
      allow create: if activeMember() && request.auth.uid == userId
        && !('verified' in request.resource.data)
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && (!('school' in request.resource.data) || request.resource.data.school is string)
        && (!('class' in request.resource.data) || request.resource.data.class is string)
        && (!('publicFields' in request.resource.data) || request.resource.data.publicFields is list)
        && (!('dateOfBirth' in request.resource.data) || request.resource.data.dateOfBirth is string)
        && (!('college' in request.resource.data) || request.resource.data.college is string)
        && (!('university' in request.resource.data) || request.resource.data.university is string)
        && (!('city' in request.resource.data) || request.resource.data.city is string);
      allow update: if (
        activeMember() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified','verifiedAt','premiumActive','premiumTheme','premiumActivatedAt','premiumActivatedBy'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 180
        && (!('school' in request.resource.data) || request.resource.data.school is string)
        && (!('class' in request.resource.data) || request.resource.data.class is string)
        && (!('publicFields' in request.resource.data) || request.resource.data.publicFields is list)
        && (!('dateOfBirth' in request.resource.data) || request.resource.data.dateOfBirth is string)
        && (!('college' in request.resource.data) || request.resource.data.college is string)
        && (!('university' in request.resource.data) || request.resource.data.university is string)
        && (!('city' in request.resource.data) || request.resource.data.city is string)
      ) || (
        isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified','verifiedAt'])
        && request.resource.data.verified is bool
        && request.resource.data.verifiedAt == request.time
      ) || (
        isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['premiumActive','premiumTheme','premiumActivatedAt','premiumActivatedBy'])
        && request.resource.data.premiumActive == true
        && request.resource.data.premiumTheme in ['ocean','sunset','mint']
        && request.resource.data.premiumActivatedAt == request.time
        && request.resource.data.premiumActivatedBy == request.auth.uid
      );
      allow delete: if false;
    }

    match /follows/{followerUid}/following/{targetUid} {
      // Signed-in members can view follower/following lists; only the owner can change their following list.
      allow read: if activeMember();
      allow create: if activeMember() && request.auth.uid == followerUid
        && targetUid != followerUid
        && request.resource.data.uid == targetUid;
      allow delete: if activeMember() && request.auth.uid == followerUid;
      allow update: if false;
    }

    match /stories/{storyId} {
      allow read: if activeMember();
      allow create: if activeMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 240
        && (request.resource.data.text.size() > 0 || ('mediaUrl' in request.resource.data))
        && (!('mediaUrl' in request.resource.data) || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://res\\.cloudinary\\.com/.*')))
        && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['image','video'])
        && (!('mediaPath' in request.resource.data) || request.resource.data.mediaPath is string)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow update: if false;
      allow delete: if activeMember() && resource.data.uid == request.auth.uid;

      match /likes/{memberUid} {
        allow read: if activeMember();
        allow create: if activeMember() && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if activeMember() && request.auth.uid == memberUid;
      }
      match /comments/{commentId} {
        allow read: if activeMember();
        allow create: if activeMember()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if activeMember() && resource.data.uid == request.auth.uid;
      }
      match /views/{viewerUid} {
        allow read: if activeMember()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid;
        allow create, update: if activeMember() && request.auth.uid == viewerUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.viewedAt == request.time;
        allow delete: if false;
      }
    }

    match /presence/{userId} {
      allow read: if activeMember();
      allow create, update: if activeMember() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.isOnline is bool
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if activeMember() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow read: if activeMember() && (!exists(/databases/$(database)/documents/chats/$(chatId)) || resource.data.members.hasAny([request.auth.uid]));
      allow create: if activeMember()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members[0] != request.resource.data.members[1];
      allow update: if activeMember()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage','lastMessageAt','lastMessageUid','unreadCounts'])
          || (resource.data.isGroup == true && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','groupName','description','photoUrl']))
        )
        && (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 120))
        && (!('lastMessageAt' in request.resource.data) || request.resource.data.lastMessageAt == request.time)
        && (!('lastMessageUid' in request.resource.data) || request.resource.data.lastMessageUid == request.auth.uid)
        && (!('unreadCounts' in request.resource.data) || request.resource.data.unreadCounts is map)
        && (!('groupName' in request.resource.data) || (resource.data.isGroup == true && request.resource.data.groupName is string && request.resource.data.groupName.size() > 0 && request.resource.data.groupName.size() <= 60))
        && (!('description' in request.resource.data) || (resource.data.isGroup == true && request.resource.data.description is string && request.resource.data.description.size() <= 300))
        && (!('photoUrl' in request.resource.data) || (resource.data.isGroup == true && request.resource.data.photoUrl is string && request.resource.data.photoUrl.matches('https://res\\.cloudinary\\.com/.*')));
      allow delete: if false;

      match /typing/{memberUid} {
        allow read: if isChatMember(chatId);
        allow create, update: if isChatMember(chatId) && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.typing is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isChatMember(chatId) && request.auth.uid == memberUid;
      }

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.text.size() > 0 || ('mediaUrl' in request.resource.data))
          && (!('mediaUrl' in request.resource.data) || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://res\\.cloudinary\\.com/.*')))
          && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['image','video'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.seenBy is list
          && request.resource.data.seenBy.size() == 0
          && (!('replyToUid' in request.resource.data) || request.resource.data.replyToUid is string)
          && (!('replyToText' in request.resource.data) || (request.resource.data.replyToText is string && request.resource.data.replyToText.size() <= 160))
          && (!('forwarded' in request.resource.data) || request.resource.data.forwarded == true);
        allow update: if (isChatMember(chatId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.edited == true
          && request.resource.data.editedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','editedAt']))
          || (isChatMember(chatId) && resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy','seenAt'])
            && request.resource.data.seenBy is list
            && (!('seenBy' in resource.data) || request.resource.data.seenBy.hasAll(resource.data.seenBy))
            && request.resource.data.seenBy.hasAny([request.auth.uid])
            && request.resource.data.seenAt == request.time);
        allow delete: if isChatMember(chatId) && resource.data.uid == request.auth.uid;

        match /reactions/{memberUid} {
          allow read: if isChatMember(chatId);
          allow create, update: if isChatMember(chatId) && request.auth.uid == memberUid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.emoji in ['👍','❤️','😂','😮','😢','🙏']
            && request.resource.data.updatedAt == request.time;
          allow delete: if isChatMember(chatId) && request.auth.uid == memberUid;
        }
      }
    }


    // Community Hub: polls and one vote per member.
    match /polls/{pollId} {
      allow read: if activeMember();
      allow create: if activeMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 4
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if activeMember() && resource.data.uid == request.auth.uid;
      match /votes/{voterUid} {
        allow read: if activeMember();
        allow create: if activeMember() && request.auth.uid == voterUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.option is int
          && request.resource.data.createdAt == request.time
          && request.resource.data.option >= 0
          && request.resource.data.option < get(/databases/$(database)/documents/polls/$(pollId)).data.options.size();
        allow update, delete: if false;
      }
    }

    // Community questions and member answers.
    match /questions/{questionId} {
      allow read: if activeMember();
      allow create: if activeMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 800
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if activeMember() && resource.data.uid == request.auth.uid;
      match /answers/{answerId} {
        allow read: if activeMember();
        allow create: if activeMember()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if activeMember() && resource.data.uid == request.auth.uid;
      }
    }

    // Streak points are deliberately small and self-reported; this is a fun feature, not a prize system.
    match /streaks/{userId} {
      allow read: if activeMember();
      allow create: if activeMember() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak <= 1
        && request.resource.data.longestStreak is int
        && request.resource.data.longestStreak <= 1
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints <= 5
        && request.resource.data.lastActiveDay is string;
      allow update: if activeMember() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','lastActiveDay','currentStreak','longestStreak','totalPoints','updatedAt'])
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints <= resource.data.totalPoints + 5
        && request.resource.data.totalPoints >= resource.data.totalPoints
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak <= resource.data.currentStreak + 1
        && request.resource.data.lastActiveDay is string;
      allow delete: if false;
    }

    // Bookmarks are private to their owner.
    match /bookmarks/{userId}/items/{postId} {
      allow read, create, update, delete: if activeMember() && request.auth.uid == userId;
    }

    // Public community events and private per-member RSVPs.
    match /events/{eventId} {
      allow read: if activeMember();
      allow create: if activeMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.startsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.createdAt == request.time;
      allow update: if activeMember() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if activeMember() && resource.data.uid == request.auth.uid;
      match /members/{memberUid} {
        allow read: if activeMember();
        allow create: if activeMember() && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if activeMember() && request.auth.uid == memberUid;
      }
    }
    match /eventRsvps/{eventId}/members/{memberUid} {
      allow read: if activeMember();
      allow create: if activeMember() && request.auth.uid == memberUid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if activeMember() && request.auth.uid == memberUid;
    }

    // Challenge entries: one entry per signed-in member per challenge.
    match /challengeEntries/{challengeId}/entries/{memberUid} {
      allow read: if activeMember();
      allow create: if activeMember() && request.auth.uid == memberUid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 400))
        && (!('correct' in request.resource.data) || request.resource.data.correct is bool);
      allow update, delete: if false;
    }

    // Birthday visibility is opt-in and stores month/day only, never a birth year.
    match /birthdayOptIns/{userId} {
      allow read: if activeMember() && resource.data.enabled == true;
      allow create, update: if activeMember() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.monthDay is string
        && request.resource.data.monthDay.size() == 5
        && request.resource.data.enabled == true;
      allow delete: if activeMember() && request.auth.uid == userId;
    }
    match /blocks/{userId}/users/{blockedUid} {
      allow read: if activeMember() && request.auth.uid == userId;
      allow create: if activeMember() && request.auth.uid == userId && blockedUid != userId
        && request.resource.data.uid == blockedUid && request.resource.data.createdAt == request.time;
      allow delete: if activeMember() && request.auth.uid == userId;
      allow update: if false;
    }
    match /memberSettings/{memberUid} {
      allow read: if activeMember() && request.auth.uid == memberUid;
      allow create, update: if activeMember()
        && request.auth.uid == memberUid
        && request.resource.data.uid == memberUid
        && request.resource.data.keys().hasOnly(['uid','dataSaver','defaultAudience','mutedWords','updatedAt'])
        && request.resource.data.dataSaver is bool
        && request.resource.data.defaultAudience in ['public','followers','private']
        && request.resource.data.mutedWords is list
        && request.resource.data.mutedWords.size() <= 30
        && request.resource.data.updatedAt == request.time;
      allow delete: if activeMember() && request.auth.uid == memberUid;
    }
    match /users/{memberUid}/drafts/{draftId} {
      allow read, delete: if activeMember() && request.auth.uid == memberUid;
      allow create, update: if activeMember()
        && request.auth.uid == memberUid
        && request.resource.data.uid == memberUid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.updatedAt == request.time;
    }
    match /admins/{adminUid} { allow read: if activeMember() && request.auth.uid == adminUid; allow write: if false; }
    match /memberControls/{memberUid} { allow read: if isAdmin(); allow create, update: if isAdmin() && request.resource.data.uid == memberUid && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.uid; allow delete: if false; }

    // Member-created groups and member-only group discussions.
    match /groups/{groupId} {
      allow read: if activeMember();
      allow create: if activeMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && !('verified' in request.resource.data)
        && !('verifiedAt' in request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if (activeMember() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified','verifiedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified','verifiedAt'])
          && request.resource.data.verified == true
          && request.resource.data.verifiedAt == request.time);
      allow delete: if isAdmin() || (activeMember() && resource.data.createdBy == request.auth.uid);

      match /members/{memberUid} {
        allow read: if activeMember();
        allow create: if activeMember() && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.joinedAt == request.time;
        allow delete: if activeMember() && request.auth.uid == memberUid;
        allow update: if false;
      }
      match /posts/{postId} {
        allow read: if activeMember();
        allow create: if isGroupMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 600
          && (request.resource.data.text.size() > 0 || ('mediaUrl' in request.resource.data))
          && (!('mediaUrl' in request.resource.data) || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://res\\.cloudinary\\.com/.*')))
          && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['image','video'])
          && (!('mediaPath' in request.resource.data) || request.resource.data.mediaPath is string)
          && request.resource.data.createdAt == request.time;
        allow update: if activeMember() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 600;
        allow delete: if activeMember() && resource.data.uid == request.auth.uid;

        match /reactions/{memberUid} {
          allow read: if activeMember();
          allow create, update: if activeMember() && request.auth.uid == memberUid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.type in ['like','love','care','haha','wow','sad','angry']
            && request.resource.data.createdAt == request.time;
          allow delete: if activeMember() && request.auth.uid == memberUid;
        }
        match /comments/{commentId} {
          allow read: if activeMember();
          allow create: if activeMember()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.displayName is string
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt == request.time;
          allow update: if isGroupMember(groupId) && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.edited == true
            && request.resource.data.editedAt == request.time;
          allow delete: if isGroupMember(groupId) && resource.data.uid == request.auth.uid;
        }
      }
    }

    // Group verification applications are submitted by the group creator or a site admin.
    match /groupVerificationRequests/{requestId} {
      allow read: if activeMember() && (resource.data.requestedBy == request.auth.uid || isAdmin());
      allow create: if activeMember()
        && request.resource.data.groupId is string
        && request.resource.data.groupName is string
        && request.resource.data.createdBy is string
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && (get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.status in ['approved','rejected'];
      allow delete: if false;
    }

    // Verification is requested by the member and granted only by an admin.
    match /verificationRequests/{memberUid} {
      allow read: if activeMember() && (request.auth.uid == memberUid || isAdmin());
      allow create: if activeMember() && request.auth.uid == memberUid
        && request.resource.data.uid == memberUid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.status in ['approved','rejected'];
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if activeMember();
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 600
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.active == true;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if activeMember()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['post','user']
        && request.resource.data.targetId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if (activeMember() && resource.data.reporterUid == request.auth.uid) || isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt']) && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.status in ['reviewed','action_taken'];
      allow delete: if false;
    }

    match /posts/{postId}/views/{viewerUid} {
      allow read: if activeMember() && (
        isAdmin() ||
        get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
      );
      allow create: if activeMember()
        && request.auth.uid == viewerUid
        && request.resource.data.keys().hasOnly(['uid','displayName','viewedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.viewedAt == request.time;
      allow update, delete: if false;
    }

    match /posts/{postId}/reactions/{memberUid} {
      allow read: if true;
      allow create, update: if activeMember()
        && request.auth.uid == memberUid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['like','love','care','haha','wow','sad','angry']
        && request.resource.data.createdAt is timestamp;
      allow delete: if activeMember() && request.auth.uid == memberUid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if (isAdmin()
        && request.resource.data.keys().hasOnly(['authorUid','authorName','text','createdAt','likes','likeCount','sponsored','sponsorLabel','sponsorOrganization','sponsorRequestId'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == 'MILOOP Sponsored'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600
        && request.resource.data.likes == []
        && request.resource.data.likeCount == 0
        && request.resource.data.sponsored == true
        && request.resource.data.sponsorLabel == 'Sponsored'
        && request.resource.data.sponsorOrganization is string
        && request.resource.data.sponsorRequestId is string
        && request.resource.data.createdAt == request.time
      ) || (activeMember()
        && request.resource.data.keys().hasOnly(['authorUid','authorName','text','mediaUrl','mediaType','mediaPath','createdAt','likes','likeCount','background','feeling','viewCount'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() > 0 || ('mediaUrl' in request.resource.data))
        && (!('mediaUrl' in request.resource.data) || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://res\\.cloudinary\\.com/.*')))
        && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['image','video'])
        && (!('mediaPath' in request.resource.data) || request.resource.data.mediaPath is string)
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0
        && request.resource.data.likeCount == 0
        && (!('viewCount' in request.resource.data) || request.resource.data.viewCount == 0)
        && (!('background' in request.resource.data) || request.resource.data.background in ['plain','sunset','ocean','mint','lavender','rose','night'])
        && (!('feeling' in request.resource.data) || request.resource.data.feeling in ['','happy','excited','grateful','loved','motivated','thoughtful','celebrating'])
        && request.resource.data.createdAt == request.time);

      allow update: if (
        activeMember()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
      ) || (
        activeMember()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','likeCount'])
        && request.resource.data.likes is list
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount == request.resource.data.likes.size()
        && request.resource.data.likeCount >= 0
        && (
          (request.resource.data.likes.size() == resource.data.likes.size() + 1
            && request.resource.data.likes.hasAll(resource.data.likes)
            && request.resource.data.likes.hasAny([request.auth.uid])
            && !resource.data.likes.hasAny([request.auth.uid]))
          ||
          (request.resource.data.likes.size() == resource.data.likes.size() - 1
            && resource.data.likes.hasAll(request.resource.data.likes)
            && resource.data.likes.hasAny([request.auth.uid])
            && !request.resource.data.likes.hasAny([request.auth.uid]))
        )
      ) || (
        activeMember()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        && existsAfter(/databases/$(database)/documents/posts/$(postId)/views/$(request.auth.uid))
      );

      allow delete: if isAdmin() || (activeMember()
        && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;

        allow create: if activeMember()
          && request.resource.data.keys().hasOnly(['uid','displayName','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;

        allow update: if activeMember()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text','edited','editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.edited == true
          && request.resource.data.editedAt == request.time;

        allow delete: if activeMember()
          && resource.data.uid == request.auth.uid;

        // A member can like a comment only once.
        match /likes/{memberUid} {
          allow read: if activeMember();

          allow create: if activeMember()
            && request.auth.uid == memberUid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.createdAt == request.time;

          allow update: if false;

          allow delete: if activeMember()
            && request.auth.uid == memberUid;
        }

        // Publicly readable reactions; each signed-in member controls their own reaction.
        match /reactions/{memberUid} {
          allow read: if true;
          allow create, update: if activeMember()
            && request.auth.uid == memberUid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.type in ['like','love','care','haha','wow','sad','angry']
            && request.resource.data.createdAt == request.time;
          allow delete: if activeMember() && request.auth.uid == memberUid;
        }

        // Replies belong to the parent comment.
        match /replies/{replyId} {
          allow read: if true;

          allow create: if activeMember()
            && request.resource.data.keys().hasOnly(['uid','displayName','text','createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 60
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt == request.time;

          allow update: if false;

          allow delete: if activeMember()
            && resource.data.uid == request.auth.uid;
        }
      }
    }
    // Monetization interest and sponsored campaign requests. No payment data is stored.
    match /monetizationRequests/{requestId} {
      allow create: if activeMember()
        && request.resource.data.keys().hasOnly(['uid','displayName','type','organization','title','details','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.type in ['premium','sponsored','creator']
        && request.resource.data.organization is string
        && request.resource.data.organization.size() <= 70
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if activeMember() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','premiumTheme','publishedPostId'])
        && request.resource.data.status in ['approved','rejected','activated','published']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (
          request.resource.data.status in ['approved','rejected']
          || (resource.data.type == 'premium' && request.resource.data.status == 'activated' && request.resource.data.premiumTheme in ['ocean','sunset','mint'])
          || (resource.data.type == 'sponsored' && request.resource.data.status == 'published' && request.resource.data.publishedPostId is string)
        );
      allow delete: if false;
    }

  }
}