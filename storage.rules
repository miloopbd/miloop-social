rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public post media is readable by everyone because MILOOP posts are public.
    // Only the authenticated owner can upload or delete files in their own folder.
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|video/(mp4|webm|quicktime)');
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}